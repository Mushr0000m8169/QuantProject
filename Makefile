# ============================================================
# QuantProject Makefile
# ============================================================

CXX      := g++
CXXFLAGS := -O2 -std=c++17 -Wall
LDFLAGS  :=

# ---------- C++ targets ----------
CPP_SRCS := backTester.cpp calculateIndicators.cpp AggressiveTester.cpp deleteFile.cpp \
            correlationTracker.cpp correlationBacktester.cpp summarizeResults.cpp
BINARIES := backtester calculateIndicators AggressiveTester deleteFile \
            correlationTracker correlationBacktester summarizeResults

# ---------- Directories ----------
TEST_RESULT_DIR   := testResult
CORR_RESULT_DIR   := correlationResult

# ============================================================
# Default target
# ============================================================
.PHONY: all
all: $(BINARIES)

# ---------- Compile rules ----------
backtester: backTester.cpp
	$(CXX) $(CXXFLAGS) $< -o $@ $(LDFLAGS)

calculateIndicators: calculateIndicators.cpp
	$(CXX) $(CXXFLAGS) $< -o $@ $(LDFLAGS)

AggressiveTester: AggressiveTester.cpp
	$(CXX) $(CXXFLAGS) $< -o $@ $(LDFLAGS)

deleteFile: deleteFile.cpp
	$(CXX) $(CXXFLAGS) $< -o $@ $(LDFLAGS)

correlationTracker: correlationTracker.cpp
	$(CXX) $(CXXFLAGS) $< -o $@ $(LDFLAGS)

correlationBacktester: correlationBacktester.cpp
	$(CXX) $(CXXFLAGS) $< -o $@ $(LDFLAGS)

summarizeResults: summarizeResults.cpp
	$(CXX) $(CXXFLAGS) $< -o $@ $(LDFLAGS)

# Full single-stock pipeline: build → backtest all stocks → write summary CSV
.PHONY: summarize
summarize: backtester summarizeResults
	./backtester
	./summarizeResults

# ============================================================
# Python helpers (optional convenience targets)
# ============================================================
.PHONY: plot plot-single plot-corr cumulative update filter test

# Run the main plot script (PNGs land in testResult/)
plot:
	python3 plotResults.py

plot-single:
	python3 singlePlot.py

# Plot pairs / correlation results → correlationResult/plots/
plot-corr:
	python3 plotCorrelation.py

cumulative:
	python3 cumulative.py

update:
	python3 dailyUpdate.py

filter:
	python3 filter.py

test:
	python3 test.py

# ============================================================
# Correlation / pairs pipeline
# ============================================================
.PHONY: corr-signals corr-backtest corr

corr-signals: correlationTracker
	./correlationTracker

corr-backtest: correlationBacktester
	./correlationBacktester

# full pairs pipeline
corr: corr-signals corr-backtest

# ============================================================
# Clean
# ============================================================
.PHONY: clean clean-png clean-corr clean-all

# Remove compiled binaries only
clean:
	rm -f $(BINARIES)
	@echo "Binaries removed."

# Remove only the PNG files generated by Python in testResult/
clean-png:
	@if [ -d "$(TEST_RESULT_DIR)" ]; then \
		find $(TEST_RESULT_DIR) -type f -name "*.png" -print -delete; \
		echo "PNG files in $(TEST_RESULT_DIR)/ removed."; \
	else \
		echo "Directory $(TEST_RESULT_DIR)/ does not exist."; \
	fi

# Remove correlation signal & equity CSVs (keeps the folder)
clean-corr:
	@if [ -d "$(CORR_RESULT_DIR)" ]; then \
		find $(CORR_RESULT_DIR) -type f \( -name "*_pair.csv" -o -name "*_equity.csv" -o -name "pairs_summary.csv" \) -print -delete; \
		echo "Correlation result CSVs removed."; \
	else \
		echo "Directory $(CORR_RESULT_DIR)/ does not exist."; \
	fi

# Full clean: binaries + PNGs + correlation outputs
clean-all: clean clean-png clean-corr
	@echo "Full clean done."

# ============================================================
# Help
# ============================================================
.PHONY: help
help:
	@echo "Available targets:"
	@echo "  make                  - build all C++ binaries"
	@echo "  make backtester       - build single-stock backtester"
	@echo "  make correlationTracker    - build pairs signal generator"
	@echo "  make correlationBacktester - build pairs backtester"
	@echo "  make corr-signals     - run correlationTracker (→ correlationResult/)"
	@echo "  make corr-backtest    - run correlationBacktester"
	@echo "  make corr             - full pairs pipeline (signals + backtest)"
	@echo "  make summarizeResults - build result summarizer only"
	@echo "  make summarize        - run backtester + summarizer → testResult/summary_all_stocks.csv"
	@echo "  make plot             - run plotResults.py (single-stock)"
	@echo "  make plot-corr        - run plotCorrelation.py (pairs)"
	@echo "  make clean            - remove C++ binaries"
	@echo "  make clean-png        - delete all *.png inside testResult/"
	@echo "  make clean-corr       - delete pair/equity CSVs in correlationResult/"
	@echo "  make clean-all        - remove binaries + PNGs + correlation CSVs"